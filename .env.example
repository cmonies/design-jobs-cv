# Copy to .env for local development. .env is gitignored — never commit it.
# Every value here is optional: without them the site builds and runs from the
# JSON in src/data, submissions fall back to GitHub issues, and candidate
# experience sections render empty.

# Cloudflare Turnstile (bot check on every form)
TURNSTILE_SECRET_KEY=

# GitHub issues for job submissions and bug reports
GITHUB_TOKEN=
GITHUB_REPO=cmonies/design-jobs-cv

# Supabase — Project Settings → API keys. The secret key is server-only and
# bypasses Row Level Security; it must never reach the browser or the repo.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Salt for the anonymous submitter fingerprint (falls back to the Turnstile secret)
FEEDBACK_SALT=
